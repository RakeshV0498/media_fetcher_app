# Copy to .env and fill in. Never commit .env.

# ---- Controller ----
APP_SECRET=change-me-long-random
AUTH_USERNAME=admin
# argon2 hash of your password (see README)
AUTH_PASSWORD_HASH=
# Generate the whole line with: python -m app.hashpw  (keep its single quotes - Compose treats $ specially)
DATABASE_URL=sqlite:///./data/app.db

# ---- Safety gate (downloads OFF until VPN verified) ----
DOWNLOADS_ENABLED=false
# Optional override; normally the node agent measures the home IP itself
HOME_PUBLIC_IP=

# ---- Scanner ----
USER_AGENT=MediaFetcher/0.1
SCAN_MIN_DELAY=1
SCAN_MAX_DELAY=4

# ---- Jellyfin ----
JELLYFIN_URL=http://jellyfin.lan:8096
JELLYFIN_API_KEY=

# ---- Optional enrichment / Telegram ----
# Posters/overviews + anime absolute->season mapping. AniList needs no key.
TMDB_API_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_BASE_URL=http://pi5.lan:8000

# ---- Node agents (step 6) ----
NODE_AGENT_TOKEN=change-me
# Node agent + qBittorrent WebUI URLs (seeded into the Nodes page on first start)
# NODE_PI5_URL=http://pi5.lan:8800
# NODE_PI5_QBIT_URL=http://pi5.lan:8080
# NODE_PI4_URL=http://pi4.lan:8800
# NODE_PI4_QBIT_URL=http://pi4.lan:8080
# DOWNLOAD_CLIENT=qbittorrent        # default is mock
QBIT_USERNAME=admin
QBIT_PASSWORD=
MIN_FREE_RESERVE_GB=5

# ---- VPN via gluetun (step 6; provider TBD, nothing hardcoded) ----
# VPN_SERVICE_PROVIDER=
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# SERVER_COUNTRIES=
# VPN_PORT_FORWARDING=off

# ---- Post-processing ----
# Comma-separated absolute roots that files may be moved into (empty = unrestricted)
# MEDIA_ROOTS=/media/movies,/media/tv,/media/anime
